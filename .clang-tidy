---
Checks: >
    bugprone-*,
    performance-*,
    modernize-*,
    readability-*,
    cppcoreguidelines-*,
    portability-*,
    misc-*,
    -modernize-use-trailing-return-type,
    -modernize-use-nodiscard,
    -cppcoreguidelines-pro-bounds-pointer-arithmetic,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-pro-type-vararg,
    -cppcoreguidelines-non-private-member-variables-in-classes,
    -cppcoreguidelines-avoid-c-arrays,
    -modernize-avoid-c-arrays,
    -readability-magic-numbers,
    -readability-identifier-length,
    -readability-named-parameter,
    -readability-function-cognitive-complexity,
    -misc-no-recursion,
    -misc-non-private-member-variables-in-classes,
    -misc-include-cleaner,
    -bugprone-easily-swappable-parameters

# bugprone-easily-swappable-parameters is off: numeric code is built from
# (sample, sample, weights) and (value, tolerance, iteration-cap) signatures,
# where every call site would need a suppression.

# Report diagnostics only in project headers: mqces/*.hpp, mqces/detail/*.hpp
# and the generated mqces/version.hpp. Third-party headers live under
# build/*/_deps/<name>-src/, which never has an "mqces/" directory directly
# above the header. clang-tidy's regex engine (llvm::Regex, POSIX ERE) has no
# lookahead, so exclusions must be expressed as a positive match.
HeaderFilterRegex: '.*/mqces/(detail/)?[A-Za-z0-9_]+\.hpp$'

# Project naming convention: snake_case for variables / functions, CamelCase
# for types, ALL_CAPS for macros, kCamelCase for constexpr/static constants.
CheckOptions:
    - { key: readability-identifier-naming.NamespaceCase,           value: lower_case }
    - { key: readability-identifier-naming.ClassCase,               value: CamelCase }
    - { key: readability-identifier-naming.StructCase,              value: CamelCase }
    - { key: readability-identifier-naming.EnumCase,                value: CamelCase }
    - { key: readability-identifier-naming.FunctionCase,            value: lower_case }
    - { key: readability-identifier-naming.VariableCase,            value: lower_case }
    - { key: readability-identifier-naming.ParameterCase,           value: lower_case }
    - { key: readability-identifier-naming.MemberCase,              value: lower_case }
    - { key: readability-identifier-naming.ConstexprVariableCase,   value: CamelCase }
    - { key: readability-identifier-naming.ConstexprVariablePrefix, value: 'k' }
    - { key: readability-identifier-naming.MacroDefinitionCase,     value: UPPER_CASE }
    - { key: readability-identifier-naming.MacroDefinitionPrefix,   value: 'MQCES_' }
    # No-op when these inferred conventions match what we already wrote.

# Every enabled check is an error, so run-clang-tidy and the tidy build
# preset fail on findings instead of printing them.
WarningsAsErrors: '*'
FormatStyle: file
...
